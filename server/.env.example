# Copiá este archivo a ".env" y completá los valores. NUNCA subas ".env" a GitHub.

# Puerto donde escucha la API
PORT=4000

# Cadena de conexión de MongoDB Atlas (o de un Mongo local)
# Ejemplo local:  mongodb://127.0.0.1:27017/vencimientos
MONGODB_URI=

# Secreto para firmar los tokens. Mínimo 32 caracteres, aleatorio.
# Generalo con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duración del token en segundos (604800 = 7 días)
JWT_TTL_SECONDS=604800

# Origenes web permitidos por CORS, separados por coma. La app móvil no lo necesita.
# Dejalo vacío si solo usás la app móvil.
CORS_ORIGINS=

# Cantidad de proxies delante de la API. 0 en tu computadora; 1 si la publicás
# en un hosting que usa proxy (así el límite de intentos ve la IP real).
TRUST_PROXY=0
