# Copiá este archivo a ".env" dentro de la carpeta mobile/.
#
# Dirección del backend. En un iPhone real NO sirve "localhost":
# usá la IP de tu computadora en la red WiFi (el iPhone y la computadora deben estar en la misma red).
#   Mac:      ipconfig getifaddr en0
#   Windows:  ipconfig   (buscá "Dirección IPv4")
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
